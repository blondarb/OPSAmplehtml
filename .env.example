# Post-interview evaluation: unset preserves inline execution; enable after human SAM deployment.
# HISTORIAN_EVAL_MODE=queue

# Enable server attending review only with literal true; default off.
HISTORIAN_ATTENDING_ENABLED=false
# Run every N localizer cycles; positive integer, default/invalid fallback 2.
HISTORIAN_ATTENDING_INTERVAL=2

# Pre-close coverage beta: default OFF; set true at build time to enable.
# NEXT_PUBLIC_HISTORIAN_PRECLOSE_GATE=false

# Patient-route localizer steer (build-time): lets the localizer run on /patient/* so its
# private hints + attending-review gaps reach Henry. Nothing is rendered to the patient.
# NEXT_PUBLIC_HISTORIAN_PATIENT_STEER=false

# /launchpad live open-items pull (Asana Portfolio subtasks). Local dev only —
# production reads Secrets Manager sevaro/asana/pat (see scripts/ops/launchpad-asana-iam-policy.sh).
# ASANA_PAT
